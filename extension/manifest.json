{
  "manifest_version": 3,
  "name": "YouTube Ad Helper",
  "short_name": "YT Helper",
  "version": "2.0.0",
  "description": "High-performance, local-only YouTube Ad Skip & Accelerator extension. Auto-clicks skip controls and handles detectable ad states.",
  "minimum_chrome_version": "110",
  "permissions": [
    "storage",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YouTube Ad Helper",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "core/logger.js",
        "core/storage.js",
        "core/detector.js",
        "core/player.js",
        "core/navigation.js",
        "core/observer.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "main-world.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "key": ""
}